# IDEA 可在 Run Configuration 的 Environment variables 中填写这些变量。
SERVER_PORT=12345
DB_URL=jdbc:mysql://127.0.0.1:3306/tihaishitu?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=请填写本机密码
CATALOG_SEED_ENABLED=true
# 至少使用 24 位随机字符串；留空时题库写接口完全关闭。
APP_ADMIN_KEY=请填写题库管理密钥
