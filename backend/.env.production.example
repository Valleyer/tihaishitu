# 万境求知 · 生产环境变量模板
#
# 用法：
#   1. 复制为服务器上的 /etc/wanjingqiuzhi/backend.env（不要提交回仓库）；
#   2. 把所有 <CHANGE_ME> / <...> 占位符换成真实值；
#   3. chmod 600，属主设为 systemd 服务运行用户；
#   4. systemd 通过 EnvironmentFile 读取本文件，见 deploy/wanjingqiuzhi.service.example。
#
# 安全约束：本仓库只保存占位符。真实数据库密码、APP_ADMIN_KEY、
# 初始管理员密码、SSH 私钥等一律不写入仓库。

# --- 监听地址 ---------------------------------------------------------------
# 只允许本机 Nginx 回源，避免 Spring Boot 12345 直接暴露公网。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=12345

# --- 数据库（MySQL 5.7）-----------------------------------------------------
# schema 保持 tihaishitu，不因产品改名而变更。
# 应用使用独立数据库账号，不长期使用 root，且只授予该 schema 的必要权限。
DB_URL=jdbc:mysql://127.0.0.1:3306/tihaishitu?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false
DB_USERNAME=wanjing_app
DB_PASSWORD=<CHANGE_ME>
DB_POOL_SIZE=10

# --- 启动期数据装载 ---------------------------------------------------------
# 生产库由 dump 导入，已有完整数据；seed 一律关闭，避免向生产库补写演示数据。
CATALOG_SEED_ENABLED=false
MATH1_KNOWLEDGE_SEED_ENABLED=false

# --- 管理后台 ---------------------------------------------------------------
# 至少 24 位随机字符串；留空时题库写接口整体关闭。
APP_ADMIN_KEY=<CHANGE_ME>

# --- CORS -------------------------------------------------------------------
# 生产同源部署（Nginx 同时托管前端与 /api）时，填正式访问来源。
CORS_ALLOWED_ORIGINS=<PRODUCTION_ORIGIN>

# --- Cookie -----------------------------------------------------------------
# 目前 HTTP 明文部署，保持 false；
# 未来启用 HTTPS 后改为 true，避免 Cookie 在明文链路中传输。
SESSION_COOKIE_SECURE=false
LEARNER_COOKIE_SECURE=false
LEARNER_SESSION_MAX_AGE=2592000

# --- 首个管理员（可选）------------------------------------------------------
# 只在数据库尚无有效 ADMIN 时创建一次；创建完成后建议从本文件移除。
# APP_INITIAL_ADMIN_USERNAME=<ADMIN_USERNAME>
# APP_INITIAL_ADMIN_PASSWORD=<CHANGE_ME>
# APP_INITIAL_ADMIN_DISPLAY_NAME=初始管理员
